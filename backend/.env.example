# Copy this file to .env in the backend root and fill in your local values.
# .env is already read by src/config/env.js — nothing else to install.

NODE_ENV=development
PORT=5000

# Local Postgres connection string. Format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/airfare_index

# Only needed if you connect to a hosted/managed Postgres (e.g. Render, Supabase)
# that requires SSL. Leave false for local Postgres.
DB_SSL=false

# React dev server origin(s), comma-separated, for CORS
CORS_ORIGINS=http://localhost:5173

# Leave blank until the scraper script is wired up
SCRAPER_SCRIPT_PATH=
PYTHON_BIN=python3
